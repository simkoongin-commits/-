rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clubs/{clubId} {
      allow read, write: if request.auth != null;

      match /shotRecords/{recordId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['ownerUid', 'memberId', 'memberName', 'date', 'createdAt', 'shots'])
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.memberId is string
          && request.resource.data.memberId.size() > 0
          && request.resource.data.memberName is string
          && request.resource.data.memberName.size() > 0
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.createdAt is string
          && request.resource.data.shots is list
          && request.resource.data.shots.size() > 0
          && request.resource.data.shots.size() <= 5000;
        allow update, delete: if false;
      }

      match /questions/{questionId} {
        allow create: if request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.status == "waiting";
        allow read, update, delete: if request.auth != null;
      }
    }

    match /public/{publicId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /qa/{questionId} {
        allow read: if true;
        allow create: if request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.status == "waiting";
        // 답변·수정·삭제는 Firebase Admin SDK를 사용하는 서버 API에서 처리합니다.
        allow update, delete: if false;
      }
    }
  }
}
