rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clubs/{clubId} {
      // Legacy browser-written 心5시 records are migrated to server-only documents.
      allow read, write: if request.auth != null && !clubId.matches('^heartFive-.*$');

      match /shotRecords/{recordId} {
        allow read, create: if false;
        allow update, delete: if false;
      }

      match /questions/{questionId} {
        allow create: if request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.status == "waiting";
        allow read, update, delete: if request.auth != null;
      }
    }

    match /public/{publicId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /qa/{questionId} {
        allow read: if true;
        allow create: if request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.status == "waiting";
        // 답변·수정·삭제는 Firebase Admin SDK를 사용하는 서버 API에서 처리합니다.
        allow update, delete: if false;
      }
    }
  }
}
